{
  "name": "vendune-experience",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "format:check": "prettier --check src tests/unit scripts *.ts *.json index.html",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:full": "vitest run --coverage --coverage.thresholds.100",
    "architecture": "node scripts/architecture.mjs",
    "localization": "node scripts/localization.mjs && node scripts/translation-catalog.mjs check && node scripts/app-localization.mjs",
    "translations": "node scripts/translation-catalog.mjs",
    "api:check": "python3 ../scripts/api_catalogue.py --check"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
