# Copy to .env if configuring manually; dev.sh generates random local secrets.
DB_PASSWORD=replace-with-a-random-secret
DATABASE_URL=postgres://commerce:replace-with-a-random-secret@127.0.0.1:15487/commerce
MERCHANT_TOKEN=replace-with-a-random-secret-at-least-24-characters
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6:35b
BIND_ADDR=127.0.0.1:8787
# Shipping demo product template for new shops. Compatibility checks explicitly select legacy-furniture.
DEMO_CATALOG=fashion

QDRANT_URL=http://127.0.0.1:16333
QDRANT_API_KEY=
# Public hosting only; resolves registered tenant IDs from shop subdomains.
SHOP_DOMAIN_SUFFIX=
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Persistent AES-256-GCM key: 64 random hex characters. Back up separately; keep identical across replicas.
# Required only to save central provider keys via the platform console. Never commit a real value.
PLATFORM_SECRET_KEY=
# Synthetic loopback provider fixtures only; keep false on public hosts.
INFERENCE_ALLOW_LOOPBACK=false
# Optional cloud inference. Keys remain server-side; leave blank for local only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Independently deployable process role: all, http, memory-worker, payment-worker, app-worker.
PROCESS_ROLE=all
# Per-process pool budget; multiply by replica/worker counts before sizing PostgreSQL.
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_POOL_WAIT_MS=5000
# Disable decoded settings/language caches and per-request memoization for diagnostics.
READ_CONTEXT_CACHE=true
# auto: one-time versioned setup for local development. Production: run migrate
# as a setup job, then serve for HTTP and every independent worker.
BOOTSTRAP_MODE=auto
PUBLIC_BASE_URL=http://127.0.0.1:8787
# Exact tenant-keyed Sandbox credentials, never live accounts or browser keys.
PAYPAL_SANDBOX_ACCOUNTS={}
# Operator-owned app service endpoints and credentials; see extensions/README.md.
APP_SERVICES={}

# Public origin for exported coding-agent config and browser MCP Origin admission (HTTPS in deployment; no credentials/path).
COMMERCE_PUBLIC_ORIGIN=http://127.0.0.1:8787

# Local development only. deploy/compose.yaml enforces false for public hosting.
SEED_DEMO=true
ALLOW_PUBLIC_SIGNUP=true
ALLOW_BOOTSTRAP_AUTH=true
# Used only by the one-shot --bootstrap-operator setup. Remove password after setup.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=Platform operator
PLATFORM_ADMIN_PASSWORD=

# Email app: exact approved public SMTP hosts, comma separated. Credentials are configured per shop in Apps.
EMAIL_SMTP_HOSTS=

# Optional private product image jobs, billed only after a merchant request. Existing server-side OpenAI key is reused.
IMAGE_GENERATION_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Optional trusted, privately operated experience service (never expose these keys to browser bundles).
IDENTITY_BROKER_ISSUER=
IDENTITY_BROKER_KEY=
HOSTED_FRONTEND_ORIGIN=
HOSTED_FRONTEND_KEY=

# Optional browser-only Google Places autocomplete (public key restricted by HTTP referrer/API/quota).
# Set before the frontend build, enable Maps JavaScript + Places API (New). No server keys here.
VITE_GOOGLE_MAPS_API_KEY=
