{
  "id": "gift_message",
  "version": "1.0.0",
  "coreApi": "1",
  "runtime": "declarative",
  "name": {
    "en": "Gift message",
    "de": "Geschenknachricht",
    "fr": "Message cadeau",
    "es": "Mensaje de regalo"
  },
  "permissions": [
    "data.read",
    "data.write",
    "storefront.slot",
    "admin.slot"
  ],
  "entities": [
    {
      "name": "rules",
      "fields": [
        {
          "name": "fee_minor",
          "kind": "integer",
          "required": true,
          "indexed": false
        }
      ],
      "publicRead": false
    }
  ],
  "slots": [
    {
      "location": "product.detail",
      "component": "product-configuration",
      "label": {
        "en": "Add a gift message",
        "de": "Geschenknachricht hinzufügen",
        "fr": "Ajouter un message cadeau",
        "es": "Añadir un mensaje de regalo"
      }
    },
    {
      "location": "admin.apps",
      "component": "entity-form",
      "label": {
        "en": "Personalization fee",
        "de": "Personalisierungspreis",
        "fr": "Prix de personnalisation",
        "es": "Precio de personalización"
      }
    },
    {
      "location": "admin.order",
      "component": "entity-list",
      "label": {
        "en": "Personalized orders",
        "de": "Personalisierte Bestellungen",
        "fr": "Commandes personnalisées",
        "es": "Pedidos personalizados"
      }
    }
  ],
  "actions": [
    {
      "name": "rules",
      "description": "Read gift-message price rules",
      "handler": "list",
      "entity": "rules",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "public": false
    },
    {
      "name": "save_rules",
      "description": "Change gift-message price rules",
      "handler": "save",
      "entity": "rules",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "fields": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "fields"
        ],
        "additionalProperties": false
      },
      "public": false
    },
    {
      "name": "orders",
      "description": "Show orders with gift messages",
      "handler": "configurations",
      "entity": null,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "public": false
    }
  ],
  "events": [],
  "configuration": {
    "entity": "rules",
    "record": "default",
    "priceField": "fee_minor",
    "inputField": "message",
    "wasmSource": ";; Gift-message-owned rules: printable input is checked by the host; app defines length and fee.\n(module\n  (func $valid_fee (export \"validate_fee\") (param $fee i64) (result i32)\n    local.get $fee i64.const 0 i64.ge_s\n    local.get $fee i64.const 500 i64.le_s i32.and)\n  (func (export \"configuration_fee\") (param $fee i64) (param $length i64) (result i64)\n    local.get $fee call $valid_fee\n    local.get $length i64.const 1 i64.ge_s i32.and\n    local.get $length i64.const 12 i64.le_s i32.and\n    if (result i64) local.get $fee else i64.const -1 end))\n",
    "defaultFields": {
      "fee_minor": 150
    },
    "label": {
      "en": "Add a gift message",
      "de": "Geschenknachricht hinzufügen",
      "fr": "Ajouter un message cadeau",
      "es": "Añadir un mensaje de regalo"
    },
    "hint": {
      "en": "Up to 12 characters. Price and tax are calculated by the shop.",
      "de": "Bis zu 12 Zeichen. Preis und Steuer berechnet der Shop.",
      "fr": "12 caractères maximum. Prix et taxe calculés par la boutique.",
      "es": "Hasta 12 caracteres. Precio e impuestos calculados por la tienda."
    }
  }
}
