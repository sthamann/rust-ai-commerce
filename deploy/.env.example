# Copy to deploy/.env (ignored). Choose independent generated secrets; URL-encode the DB password in DATABASE_URL.
COMMERCE_DOMAIN=commerce-api.example.com
DB_PASSWORD=replace-with-a-long-generated-password
DATABASE_URL=postgres://commerce:replace-with-a-long-generated-password@postgres:5432/commerce
MERCHANT_TOKEN=replace-with-at-least-32-random-characters
OLLAMA_URL=http://your-private-model-host:11434
OLLAMA_MODEL=qwen3.6:35b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
APP_SERVICES={}
BOOTSTRAP_MODE=auto

# Public hosting: no demo customers/signup or HTTP instance-token access.
SEED_DEMO=false
ALLOW_PUBLIC_SIGNUP=false
ALLOW_BOOTSTRAP_AUTH=false
# Used only by the one-shot --bootstrap-operator setup. Remove password after setup.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=Platform operator
PLATFORM_ADMIN_PASSWORD=

# Optional Email Delivery app: exact approved SMTP hostnames (TLS required).
EMAIL_SMTP_HOSTS=
